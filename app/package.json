{
    "name": "homemaker-suite-app",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "predev": "node scripts/build-index.js && node scripts/build-metadata.js",
        "prebuild": "node scripts/build-index.js && node scripts/build-metadata.js",
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "deploy:vercel": "vercel --prod",
        "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name homemaker-suite --commit-dirty=true",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@capacitor/android": "^8.0.2",
        "@capacitor/cli": "^8.0.2",
        "@capacitor/core": "^8.0.2",
        "@supabase/supabase-js": "^2.43.4",
        "clsx": "^2.1.0",
        "framer-motion": "^11.0.3",
        "lucide-react": "^0.323.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^6.22.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^2.2.1"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^14.2.1",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^18.2.55",
        "@types/react-dom": "^18.2.19",
        "@vitejs/plugin-react": "^4.2.1",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.56.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.5",
        "jsdom": "^24.0.0",
        "postcss": "^8.4.35",
        "tailwindcss": "^3.4.1",
        "vite": "^5.1.0",
        "vite-plugin-pwa": "^1.2.0",
        "vitest": "^1.3.1",
        "workbox-window": "^7.4.1"
    }
}
